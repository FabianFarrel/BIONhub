# ---- BIONhub Backend Environment Variables ----
# Copy this file to ".env" and fill in your own values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Get this from: Atlas Dashboard > Connect > Drivers > copy the connection string.
# Replace <username>, <password>, and <cluster> with your own values,
# and append the database name "bionhub" before the "?".
# Example:
# MONGODB_URI=mongodb+srv://myuser:mypass@cluster0.abcd123.mongodb.net/bionhub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bionhub?retryWrites=true&w=majority

# JSON Web Token secret. Use a long, random string in production.
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins for CORS (web app, etc.)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:8081
